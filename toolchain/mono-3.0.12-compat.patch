+static gboolean
+arm_patch_literal (guint32 *code32, guint32 target)
+{
+	/* LDR Rd, [PC, #0] loads the literal at PC+8 for every destination
+	 * register, not just IP/R12 as used by far-call thunks. */
+	if ((code32 [0] & 0xffff0fffU) != 0xe59f0000U)
+		return FALSE;
+	code32 [2] = target;
+	return TRUE;
