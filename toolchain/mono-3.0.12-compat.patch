+/* Diagnose malformed IR before later passes index opcode metadata. */
+static void
+legacy_check_ir (MonoCompile *cfg, const char *stage)
+{
+    MonoBasicBlock *bb;
+    if (!getenv ("OSU_ARM_DIAGNOSTICS"))
+        return;
+    for (bb = cfg->bb_entry; bb; bb = bb->next_bb) {
+        MonoInst *ins;
+        for (ins = bb->code; ins; ins = ins->next) {
+            if (ins->opcode < MONO_CEE_LAST) {
+                g_printerr ("OSU invalid IR stage=%s method=%s:%s block=%d opcode=%u il=%p dreg=%d sreg1=%d sreg2=%d prev=%u next=%u\n",
+                    stage, cfg->method->klass->name, cfg->method->name,
+                    bb->block_num, ins->opcode, ins->cil_code,
+                    ins->dreg, ins->sreg1, ins->sreg2,
+                    ins->prev ? ins->prev->opcode : 0,
+                    ins->next ? ins->next->opcode : 0);
+                g_assert (ins->opcode >= MONO_CEE_LAST);
+            }
+        }
+    }
+}
